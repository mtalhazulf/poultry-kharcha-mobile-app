# Release signing for `bun run apk:release` / `bun run bundle:release`.
#
# 1. Generate a keystore (once; keep it and these passwords out of git — both
#    android/keystore.properties and android/app/*.keystore are git-ignored):
#
#      keytool -genkeypair -v \
#        -keystore android/app/kharcha-release.keystore \
#        -alias kharcha -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file to android/keystore.properties and fill in the values.
#    storeFile is resolved relative to android/app.
#
# If android/keystore.properties is absent, release builds fall back to the
# debug keystore (with a warning) so they still compile — do not ship those.

storeFile=kharcha-release.keystore
storePassword=CHANGE_ME
keyAlias=kharcha
keyPassword=CHANGE_ME
