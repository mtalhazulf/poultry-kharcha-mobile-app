# Copy to `.env` and fill in. react-native-config bakes these into the APK at
# build time — rebuild after changing them.

# Supabase project (Settings -> API). The publishable key is safe to ship in
# the client; RLS is what protects the data.
SUPABASE_URL=https://ikiepqpfhmdprqezrbgq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_1WZX331OhkRu_rc-PFkTWw_jfCDPJQB

# Google Cloud -> Credentials -> OAuth 2.0 Client ID of type *Web application*.
# (Also create an *Android* client with your package name + SHA-1; that one is
# not referenced here, Google resolves it from the signing certificate.)
GOOGLE_WEB_CLIENT_ID=

# Deep link Supabase redirects to after browser-based OAuth. Must match the
# intent-filter in android/app/src/main/AndroidManifest.xml and be listed
# under Authentication -> URL Configuration -> Redirect URLs in Supabase.
OAUTH_REDIRECT_URL=kharcha://auth/callback
